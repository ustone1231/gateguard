# GateGuard 환경변수 (루트 — docker-compose 가 읽음)
#
# 사용법:
#   dev : 이 파일 없이도 compose 기본값으로 기동됨. 값 바꾸려면 `cp .env.example .env` 후 편집.
#   prod: `cp .env.example .env.prod` → secret 전부 실값 교체 → `docker compose --env-file .env.prod ... up -d`
#
# 정책 전문: docs/secret-management.md
# 이 파일(.env.example)만 git 추적됨. .env / .env.prod 은 .gitignore 로 제외.

# ─── Secret (prod 에서 반드시 교체) ───────────────────
# AI → backend Bearer (ai·backend 동일 값)
AI_SERVICE_TOKEN=dev-ai-service-token-please-change-32
# Mock AFC → backend Bearer (backend·AFC sender 동일 값)
AFC_SERVICE_TOKEN=dev-afc-service-token-please-change-32
# backend JWT 서명 키
JWT_SECRET=dev-jwt-secret-please-change-before-prod
# DB 비밀번호 (DATABASE_URL 이 이 값을 부품으로 사용)
POSTGRES_PASSWORD=gateguard
# 카드 해싱 salt (backend·Mock AFC 동일해야 매칭됨)
CARD_HASH_SALT=dev-card-hash-salt

# ─── Config (환경별·비민감) ───────────────────────────
POSTGRES_USER=gateguard
POSTGRES_DB=gateguard
# backend 저장소 모드
STORAGE_BACKEND=sql
# backend CORS 허용 오리진. dev=* / prod 은 프론트 오리진으로 제한
CORS_ALLOW_ORIGINS=*
# ai → backend base URL (compose 내부 통신; 보통 그대로 둠)
BACKEND_URL=http://backend:8000
# frontend(브라우저) → backend
#   dev  : http://localhost:8000
#   prod : Tailscale 주소 예) http://tyler-pc.tail87a6d1.ts.net:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# 참고: 클립 저장 backend env(VIDEO_CLIP_DIR / VIDEO_CLIP_TTL_HOURS /
#       VIDEO_CLIP_SIGNED_URL_TTL_SECONDS)는 "클립 저장소" 마일스톤에서 별도 관리.
