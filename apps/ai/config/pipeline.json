{
  "model": {
    "weights": "yolo11n.pt",
    "device": "auto",
    "conf_threshold": 0.4,
    "iou_threshold": 0.5,
    "classes": [0]
  },
  "tracker": {
    "type": "bytetrack",
    "config": "bytetrack.yaml"
  },
  "pose_estimator": {
    "enabled": false,
    "_comment": "Set true after running scripts/download_models.sh. Uses Ultralytics YOLO pose and maps detections to ByteTrack tracks by IoU.",
    "weights": "models/yolo11n-pose.pt",
    "device": "auto",
    "conf_threshold": 0.35,
    "iou_match_threshold": 0.30
  },
  "age_estimator": {
    "enabled": false,
    "type": "mivolo",
    "_comment": "Optional MiVOLO wrapper. Requires external package + weights; see scripts/download_models.sh and README.",
    "detector_weights": "models/yolov8x_person_face.pt",
    "checkpoint": "models/mivolo_imbd.pth.tar",
    "device": "cpu",
    "with_persons": true,
    "disable_faces": false,
    "iou_match_threshold": 0.30
  },
  "eligibility_signals": {
    "enabled": true,
    "_comment": "MVP heuristic signals for backend v0.2.2 matching. Gender stays unknown until a real model is integrated.",
    "slow_speed_px_per_sec": 80.0,
    "fast_speed_px_per_sec": 220.0,
    "child_bbox_height_px": 90.0,
    "adult_bbox_height_px": 150.0,
    "min_age_group_confidence": 0.35
  },
  "rules": {
    "gate_passage": {
      "enabled": true,
      "recent_window_frames": 3,
      "cooldown_seconds": 0.0
    },
    "jump": {
      "enabled": true,
      "top_speed_threshold": 15.0,
      "height_std_threshold": 30.0,
      "min_history_frames": 10,
      "cooldown_seconds": 0.0,
      "_comment_cooldown": "중복 발화 제거는 JumpRule 내부 디바운스가 담당하므로 cooldown=0 으로 두어 엔진이 매 프레임 평가하게 함"
    },
    "crawling": {
      "enabled": true,
      "height_ratio_threshold": 0.55,
      "min_frames_crawling": 8,
      "cooldown_seconds": 0.0,
      "_comment_cooldown": "중복 발화 제거는 CrawlingRule 내부 디바운스가 담당하므로 cooldown=0"
    },
    "tailgating": {
      "enabled": true,
      "max_gap_seconds": 1.5,
      "cooldown_seconds": 3.0
    },
    "unpaid": {
      "enabled": true,
      "cooldown_seconds": 5.0
    }
  },
  "publisher": {
    "type": "file",
    "_comment_type_options": ["file", "http"],
    "file_path": "runs/events.jsonl",
    "http_endpoint": "http://localhost:8000",
    "_comment_http_endpoint": "base URL only (path /api/v1/events appended in factory). BACKEND_URL env overrides this.",
    "http_timeout": 2.0,
    "http_token": null
  },
  "pipeline": {
    "camera_id": "camera_001",
    "save_annotated_video": true,
    "output_dir": "runs"
  }
}
